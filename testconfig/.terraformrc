# Dev override — makes Terraform use the locally built binary instead of
# downloading from the registry. Place this file at the repo root and set:
#
#   export TF_CLI_CONFIG_FILE="$PWD/testconfig/.terraformrc"
#
# before running any terraform commands in testconfig/step*/

provider_installation {
  dev_overrides {
    "hashicorp/kubernetes" = "/Users/midhunmohanan/Desktop/terraform-provider-kubernetes"
  }
  direct {}
}
